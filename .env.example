# Copy to .env.local. None of this is needed for `npm run dev`
# (development falls back to fixed test values). Production REQUIRES them.

# Public address of the site, used for absolute links in link previews
# (WhatsApp, iMessage, X…). Defaults to https://ma-jal.com.
SITE_URL=

# Database and photo storage (Supabase). Server-side only; never expose the
# secret key to the browser. Without these, production refuses to run unless
# MAJAL_ALLOW_LOCAL_STORE=1 (local demo with files in .data/).
SUPABASE_URL=https://nmiykgowbpbtblmanqgz.supabase.co
SUPABASE_SECRET_KEY=
# MAJAL_ALLOW_LOCAL_STORE=1

# Human check on the report form (Cloudflare Turnstile, free). Create a
# widget for the site's domain at dash.cloudflare.com > Turnstile. Without
# these, reports are protected by rate limits and the hidden trap field only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Long random strings, e.g. `openssl rand -hex 32`. Changing PHONE_HASH_SECRET
# makes existing signatures unrecognisable, so treat it as permanent.
SESSION_SECRET=
PHONE_HASH_SECRET=

# Password for /ar/admin (the review queue). If unset in production, admin is off.
ADMIN_PASSWORD=

# SMS provider for one-time codes. Unset = test mode with the fixed code 123456
# (refused in production unless you opt in below, for a closed demo only).
SMS_PROVIDER=
MAJAL_ALLOW_DEV_OTP=

# Place search on the report map (OpenStreetMap Nominatim). The public
# instance allows ~1 request/second, no autocomplete, and requires a
# User-Agent that identifies your app and a contact, e.g. "Majal/1.0 (you@example.com)".
# For real traffic, point NOMINATIM_URL at a self-hosted instance or swap
# src/lib/geocode.ts for another provider (e.g. PACI, once permitted).
GEOCODER_USER_AGENT=
NOMINATIM_URL=

# Online monitoring (admin > Signals). Claude searches the web for complaints
# about public places in Kuwait and adds them to the review inbox.
ANTHROPIC_API_KEY=
# A scheduler calls GET /api/cron/signals with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Optional tuning (defaults shown):
# SIGNALS_LANGUAGES=ar,en,ur,hi,tl,ml,bn,ta,si,ne   languages to rotate through
# SIGNALS_LANGUAGES_PER_RUN=2                       languages per scheduled call
# SIGNALS_MAX_SEARCHES=6                            web searches per language per call
# SIGNALS_MODEL=claude-opus-5-5

# Optional: MapLibre style URL (e.g. PACI vector style once permission is granted).
NEXT_PUBLIC_MAP_STYLE=
